<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Le Quinté Quotidien — votre avis</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--purple:#1a2a4a;--purple-mid:#2d4a7a;--gold:#c9a84c;--gold-light:#e8c97a;--cream:#f5f0e8;--blue:#1d4e79;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',sans-serif;background:var(--purple);min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:24px;}
header{text-align:center;margin:8px 0 28px;}
.main{font-size:34px;}
h1{font-family:'Playfair Display',serif;color:var(--gold-light);font-size:1.7rem;margin:10px 0 4px;}
.subtitle{color:rgba(255,255,255,0.45);font-size:0.78rem;letter-spacing:2px;text-transform:uppercase;}
.back{display:inline-block;margin-top:14px;color:#a5b4fc;text-decoration:none;font-size:.88rem;font-weight:600;}
.back:hover{text-decoration:underline;}
.lang-btn{margin-top:12px;display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,0.08);
  color:rgba(255,255,255,0.7);font-size:0.8rem;font-weight:500;padding:5px 14px;border-radius:30px;
  border:1px solid rgba(255,255,255,0.2);cursor:pointer;font-family:'DM Sans',sans-serif;}
.lang-btn:hover{background:rgba(255,255,255,0.14);color:#fff;}
.card{background:var(--cream);border-radius:14px;padding:32px 34px;width:100%;max-width:560px;box-shadow:0 8px 40px rgba(0,0,0,0.4);}
.info-box{background:#eef4ff;border-left:4px solid var(--blue);border-radius:6px;padding:12px 16px;margin-bottom:26px;font-size:0.88rem;color:#2d3a5a;line-height:1.5;}
.info-box strong{display:block;margin-bottom:4px;color:var(--purple);}
label{display:block;font-size:0.82rem;font-weight:500;color:#2a2a2a;margin-bottom:6px;letter-spacing:0.5px;}
input[type=text],input[type=email]{width:100%;padding:11px 14px;border:1.5px solid #ccc;border-radius:8px;font-size:0.97rem;font-family:'DM Sans',sans-serif;background:#fff;}
input:focus,textarea:focus{outline:none;border-color:var(--blue);}
textarea{width:100%;padding:11px 14px;border:1.5px solid #ccc;border-radius:8px;font-size:0.97rem;font-family:'DM Sans',sans-serif;background:#fff;resize:vertical;min-height:90px;}
.field{margin-bottom:22px;}
.question{font-size:0.95rem;font-weight:500;color:#1a1a1a;margin-bottom:10px;line-height:1.45;}
.choix{display:block;background:#fff;border:1.5px solid #dcdcdc;border-radius:8px;padding:10px 13px;margin-bottom:7px;
  font-size:0.92rem;color:#2a2a2a;cursor:pointer;transition:border-color .15s,background .15s;}
.choix:hover{border-color:var(--blue);}
.choix input{margin-right:9px;}
.choix.sel{border-color:var(--blue);background:#eef4fb;}
.facultatif{font-weight:400;color:#777;font-size:0.78rem;}
button[type=submit]{width:100%;padding:14px;background:var(--blue);color:#fff;font-family:'Playfair Display',serif;font-size:1.05rem;border:none;border-radius:8px;cursor:pointer;margin-top:6px;}
button[type=submit]:hover{background:#2f6ea5;}
button[type=submit]:disabled{opacity:.6;cursor:default;}
.success{display:none;text-align:center;padding:16px 0;}
.success .check{font-size:48px;margin-bottom:12px;}
.success p{color:#2a2a2a;font-size:1rem;line-height:1.6;}
.err{display:none;background:#fdecec;border-left:4px solid #c0392b;border-radius:6px;padding:11px 14px;margin-top:14px;color:#7c2418;font-size:0.88rem;}
.footer{margin:22px 0 10px;color:rgba(255,255,255,0.3);font-size:0.72rem;text-align:center;}
</style>
</head>
<body>

<header>
  <div class="main">🖐️</div>
  <h1>Le Quinté Quotidien</h1>
  <div class="subtitle lang-fr">Votre avis sur le test</div>
  <div class="subtitle lang-en" style="display:none">Your feedback on the trial</div>
  <a class="back lang-fr" href="presentation.html">&larr; Retour à la présentation</a>
  <a class="back lang-en" style="display:none" href="presentation.html">&larr; Back to the tournament overview</a>
  <br>
  <button class="lang-btn" id="lang-btn" type="button">🇬🇧 English</button>
</header>

<div class="card">

  <div class="info-box lang-fr">
    <strong>Merci de prendre un instant.</strong>
    C'est votre avis qui décidera si ce tournoi reste — et sous quelle forme.
    Aucune question n'est obligatoire, sauf votre pseudo.
  </div>
  <div class="info-box lang-en" style="display:none">
    <strong>Thank you for taking a moment.</strong>
    Your opinion will decide whether this tournament stays — and in what form.
    No question is required, except your nickname.
  </div>

  <form id="avisForm" action="https://bridge.3050.fr/submit-email" method="POST">
    <input type="hidden" name="type" value="avis-quinte">

    <div class="field">
      <label class="lang-fr" for="pseudo">Votre pseudo Funbridge</label>
      <label class="lang-en" style="display:none" for="pseudo">Your Funbridge nickname</label>
      <input type="text" id="pseudo" name="pseudo" maxlength="60" required autocomplete="off">
    </div>

    <div class="field">
      <div class="question lang-fr">Cinq donnes plutôt que trois, qu'en pensez-vous ?</div>
      <div class="question lang-en" style="display:none">Five deals instead of three — what do you think?</div>
      <label class="choix"><input type="radio" name="format" value="mieux"><span class="lang-fr">C'est mieux : on peut se rattraper</span><span class="lang-en" style="display:none">Better: there is room to recover</span></label>
      <label class="choix"><input type="radio" name="format" value="egal"><span class="lang-fr">Ça ne change pas grand-chose</span><span class="lang-en" style="display:none">It doesn't change much</span></label>
      <label class="choix"><input type="radio" name="format" value="trois"><span class="lang-fr">Je préférais trois donnes</span><span class="lang-en" style="display:none">I preferred three deals</span></label>
    </div>

    <div class="field">
      <div class="question lang-fr">Les bonus quotidiens aux cinq premiers (5-4-3-2-1) ?</div>
      <div class="question lang-en" style="display:none">The daily bonuses for the top five (5-4-3-2-1)?</div>
      <label class="choix"><input type="radio" name="bonus" value="plait"><span class="lang-fr">Ça me plaît, ça rend le jeu plus vivant</span><span class="lang-en" style="display:none">I like it, it makes the game livelier</span></label>
      <label class="choix"><input type="radio" name="bonus" value="egal"><span class="lang-fr">Ça m'est égal</span><span class="lang-en" style="display:none">I don't mind either way</span></label>
      <label class="choix"><input type="radio" name="bonus" value="fausse"><span class="lang-fr">Ça fausse le classement</span><span class="lang-en" style="display:none">It distorts the ranking</span></label>
    </div>

    <div class="field">
      <div class="question lang-fr">Le Quinté devrait-il un jour remplacer le Trio ?</div>
      <div class="question lang-en" style="display:none">Should the Quinté eventually replace the Trio?</div>
      <label class="choix"><input type="radio" name="remplacer" value="oui"><span class="lang-fr">Oui</span><span class="lang-en" style="display:none">Yes</span></label>
      <label class="choix"><input type="radio" name="remplacer" value="non"><span class="lang-fr">Non, je tiens au Trio</span><span class="lang-en" style="display:none">No, I want to keep the Trio</span></label>
      <label class="choix"><input type="radio" name="remplacer" value="sansavis"><span class="lang-fr">Sans avis / les deux me vont</span><span class="lang-en" style="display:none">No opinion / both suit me</span></label>
    </div>

    <div class="field">
      <label class="lang-fr" for="commentaire">Vos remarques <span class="facultatif">(facultatif)</span></label>
      <label class="lang-en" style="display:none" for="commentaire">Your comments <span class="facultatif">(optional)</span></label>
      <textarea id="commentaire" name="commentaire" maxlength="2000"></textarea>
    </div>

    <div class="field">
      <label class="lang-fr" for="email">Votre email <span class="facultatif">(facultatif, si vous souhaitez une réponse)</span></label>
      <label class="lang-en" style="display:none" for="email">Your email <span class="facultatif">(optional, if you would like a reply)</span></label>
      <input type="email" id="email" name="email" maxlength="120" autocomplete="off">
    </div>

    <button type="submit">
      <span class="lang-fr">Envoyer mon avis</span>
      <span class="lang-en" style="display:none">Send my feedback</span>
    </button>
    <div class="err" id="errMsg"></div>
  </form>

  <div class="success" id="successMsg">
    <div class="check">🖐️</div>
    <p class="lang-fr"><strong>Merci beaucoup !</strong><br>Votre avis est enregistré. Il comptera vraiment dans la décision.</p>
    <p class="lang-en" style="display:none"><strong>Thank you very much!</strong><br>Your feedback has been recorded. It will genuinely count.</p>
  </div>

</div>

<div class="footer">Le Quinté Quotidien · test du 17 au 30 septembre 2026</div>

<script>
var MOTS = {
  fr: { erreur: "L'envoi n'a pas abouti. Vérifiez votre connexion et réessayez.", pseudo: 'Merci d’indiquer votre pseudo Funbridge.' },
  en: { erreur: 'Sending failed. Please check your connection and try again.', pseudo: 'Please enter your Funbridge nickname.' }
};

function setLang(l){
  document.documentElement.lang = l;
  var fr = l !== 'en';
  Array.prototype.forEach.call(document.querySelectorAll('.lang-fr'), function(e){ e.style.display = fr ? '' : 'none'; });
  Array.prototype.forEach.call(document.querySelectorAll('.lang-en'), function(e){ e.style.display = fr ? 'none' : ''; });
  document.getElementById('lang-btn').innerHTML = fr ? '🇬🇧 English' : '🇫🇷 Français';
  try { localStorage.setItem('pblang', fr ? 'fr' : 'en'); } catch(e) {}
}
var pref = 'fr';
try { pref = localStorage.getItem('pblang') || 'fr'; } catch (e) {}
setLang(pref === 'en' ? 'en' : 'fr');
document.getElementById('lang-btn').addEventListener('click', function(){
  setLang(document.documentElement.lang === 'en' ? 'fr' : 'en');
});

/* Le choix retenu se voit d'un coup d'œil, sans avoir à viser la pastille. */
Array.prototype.forEach.call(document.querySelectorAll('.choix input'), function(r){
  r.addEventListener('change', function(){
    Array.prototype.forEach.call(document.getElementsByName(r.name), function(x){
      x.parentNode.className = 'choix';
    });
    r.parentNode.className = 'choix sel';
  });
});

var form = document.getElementById('avisForm');
var err = document.getElementById('errMsg');
form.addEventListener('submit', async function(e){
  e.preventDefault();
  var lang = document.documentElement.lang === 'en' ? 'en' : 'fr';
  err.style.display = 'none';
  if (!document.getElementById('pseudo').value.trim()){
    err.textContent = MOTS[lang].pseudo; err.style.display = 'block'; return;
  }
  var bouton = form.querySelector('button[type=submit]');
  bouton.disabled = true;
  try {
    var resp = await fetch(form.action, { method:'POST', body:new FormData(form), headers:{ 'Accept':'application/json' } });
    if (resp.ok){
      form.style.display = 'none';
      document.getElementById('successMsg').style.display = 'block';
      return;
    }
    throw new Error('HTTP ' + resp.status);
  } catch (e2) {
    err.textContent = MOTS[lang].erreur; err.style.display = 'block';
    bouton.disabled = false;
  }
});
</script>

</body>
</html>
